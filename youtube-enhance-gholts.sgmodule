#!name=YouTube 增强
#!desc=去除油管广告 / 支持后台播放 / 画中画 / 自动最高画质
#!author=gholts
#!icon=https://iili.io/KQ67Yxa.png
#!homepage=https://github.com/gholts/surge/tree/main/modules
#!tag=YouTube,去广告,增强
#!arguments=blockUpload:true,blockShorts:true,autoHd:true,blockGames:true,blockVerticalLive:true,jumpAhead:true,blockStore:true,nativeDownload:true,subtitle_type:"Translate",auto_cc:true,show_only_auto_translation:false

[URL Rewrite]
# 广告相关直接 404
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject
# timedtext：把 tlang 改写为 subtype=Translate，供字幕脚本识别
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$2&$4&subtype=Translate$5 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ https://$1$2&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$3&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)(#.*)?$ https://$1subtype=Translate$3 302

[Script]
# 1) 空响应拦截 ad_break（请求阶段）
YT-ad_break = type=http-request, pattern=^https://youtubei\.googleapis\.com/youtubei/v1/player/ad_break(?:\?.*)?$, script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/youtube-ad-break.js, timeout=10

# ad_break 空响应
YT-ad-break = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, timeout=15

# 原生下载（响应）
YT-download = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js, requires-body=true, binary-body-mode=true, timeout=30, argument={"nativeDownload":{{{nativeDownload}}}}

# player 请求（原生下载相关）
YT-download-player = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15, argument={"nativeDownload":{{{nativeDownload}}}}

# 主响应增强（去广告 / UI / 画质等）
YT-response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js, requires-body=true, binary-body-mode=true, timeout=30, argument="{"blockUpload":{{{blockUpload}}},"blockShorts":{{{blockShorts}}},"blockGames":{{{blockGames}}},"blockVerticalLive":{{{blockVerticalLive}}},"jumpAhead":{{{jumpAhead}}},"autoHd":{{{autoHd}}},"blockStore":{{{blockStore}}}}"

# initplayback 响应（UMP）
YT-ump = type=http-response, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js, requires-body=true, binary-body-mode=true, timeout=30, argument="{"blockGames":{{{blockGames}}},"blockVerticalLive":{{{blockVerticalLive}}},"jumpAhead":{{{jumpAhead}}},"autoHd":{{{autoHd}}},"blockStore":{{{blockStore}}}}"

# initplayback 请求
YT-init = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15

# videoplayback 自动高清
YT-auto-hd = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15, argument={"autoHd":{{{autoHd}}}}

# log_event
YT-log-event = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15

# 2) 双语字幕（响应）——完整可用
YT-DualSubs = type=http-response, pattern=^https://(?:www|m)\.youtube\.com/api/timedtext(?:\?|$), script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/youtube-dual-subs.js, requires-body=true, timeout=30, argument=subtitle_type={{{subtitle_type}}}&show_only_auto_translation={{{show_only_auto_translation}}}

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, tv.youtube.com, s.youtube.com, music.youtube.com
