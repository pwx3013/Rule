# Loon 插件：YouTube Enhance（由 gholts 的 Surge 模块移植）
# 原项目：https://github.com/gholts/surge

#!name=YouTube Enhance
#!desc=移除 YouTube 广告，支持后台播放、画中画、最高 4 倍速。可隐藏不需要的版块、优先最高画质、启用 Jump Ahead。基于 Maasea 的代码 (Apache-2.0)。
#!author=gholts
#!system=iOS
#!tag=YouTube,去广告

[Argument]
block_upload = switch,true,tag=隐藏上传入口,desc=隐藏 YouTube 导航栏中的上传入口
block_shorts = switch,false,tag=隐藏 Shorts 入口,desc=隐藏 YouTube 导航栏中的 Shorts 入口
auto_hd = switch,true,tag=自动最高画质,desc=优先使用最高可用画质并防止自动降质
block_games = switch,true,tag=隐藏游戏推荐,desc=隐藏 YouTube Playables 推荐
block_vertical_live = switch,false,tag=隐藏竖屏直播推荐,desc=隐藏各布局中的竖屏直播推荐
jump_ahead = switch,true,tag=启用 Jump Ahead,desc=启用 YouTube 原生 Jump Ahead 按钮（无推广）
block_store = switch,true,tag=隐藏创作者商店,desc=隐藏视频下方和频道页的创作者商店与购物区
native_download = switch,false,tag=原生下载（实验性）,desc=实验性原生下载；未设置画质时用 720p，服务器限制可能仍然生效

[Script]
youtube.enhance.ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js
youtube.enhance.download = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js,argument={"nativeDownload":{native_download}}
youtube.enhance.download-player = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,argument={"nativeDownload":{native_download}}
youtube.enhance.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js,argument={"blockUpload":{block_upload},"blockShorts":{block_shorts},"blockGames":{block_games},"blockVerticalLive":{block_vertical_live},"jumpAhead":{jump_ahead},"autoHd":{auto_hd},"blockStore":{block_store}}
youtube.enhance.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js,argument={"blockGames":{block_games},"blockVerticalLive":{block_vertical_live},"jumpAhead":{jump_ahead},"autoHd":{auto_hd},"blockStore":{block_store}}
youtube.enhance.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js
youtube.enhance.auto-hd = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,argument={"autoHd":{auto_hd}}
youtube.enhance.log-event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js

[Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject

[Mitm]
hostname = *.googlevideo.com, youtubei.googleapis.com, *.youtube.com
