# YouTube 增强 Quantumult X 重写配置 (Snippet)
# 参数配置：
# blockUpload=true, blockShorts=true, autoHd=true, blockGames=true, blockVerticalLive=true,
# jumpAhead=true, blockStore=true, nativeDownload=true, subtitle_type=Translated, auto_cc=true, show_only_auto_translation=true
[rewrite_local]
^https:\/\/(www|m)\.youtube\.com\/api\/timedtext\? url script-response-body https://raw.githubusercontent.com/DualSubs/YouTube/main/dist/DualSubs.YouTube.min.js
[mitm]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, s.youtube.com