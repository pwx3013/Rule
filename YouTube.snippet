# YouTube 增强 Quantumult X 重写配置 (Snippet)
# 参数配置：
# blockUpload=true, blockShorts=true, autoHd=true, blockGames=true, blockVerticalLive=true,
# jumpAhead=true, blockStore=true, nativeDownload=true, subtitle_type=Translated, auto_cc=true, show_only_auto_translation=true

[rewrite_local]
# 1. 基础广告拦截
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ url reject-200
^https:\/\/s\.youtube\.com\/api\/stats\/ads url reject-200

# 2. 字幕请求改写（将 tlang 改写为 subtype=Translate 供字幕脚本识别）
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ url 302 https://$1$2&$4&subtype=Translate$5
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ url 302 https://$1$2&subtype=Translate$4
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ url 302 https://$1$3&subtype=Translate$4
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)(#.*)?$ url 302 https://$1subtype=Translate$3

# 3. 广告拦截脚本（空响应）
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js

# 4. 原生下载 (响应)
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js#argument={"nativeDownload":true}

# 5. player 请求 (原生下载相关)
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js#argument={"nativeDownload":true}

# 6. 主响应增强（去广告 / 屏蔽上传 / 屏蔽Shorts / 屏蔽游戏 / 屏蔽竖屏直播 / 自动高清 / 快进 / 屏蔽商店）
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js#argument={"blockUpload":true,"blockShorts":true,"blockGames":true,"blockVerticalLive":true,"jumpAhead":true,"autoHd":true,"blockStore":true}

# 7. initplayback 响应 (UMP)
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js#argument={"blockGames":true,"blockVerticalLive":true,"jumpAhead":true,"autoHd":true,"blockStore":true}

# 8. initplayback 请求
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js

# 9. videoplayback 自动高清
^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback url script-request-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js#argument={"autoHd":true}

# 10. log_event
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event url script-request-body https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js

# 11. 双语/翻译字幕 (响应)
^https://(?:www|m)\.youtube\.com/api/timedtext(?:\?|$) url script-response-body https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/youtube-dual-subs.js#subtitle_type=Translated&show_only_auto_translation=true&auto_cc=true

[mitm]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, tv.youtube.com, s.youtube.com, music.youtube.com
