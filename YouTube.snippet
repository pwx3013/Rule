# YouTube 增强 Quantumult X 重写配置 (Snippet)
# 参数配置：
# blockUpload=true, blockShorts=true, autoHd=true, blockGames=true, blockVerticalLive=true,
# jumpAhead=true, blockStore=true, nativeDownload=true, subtitle_type=Translated, auto_cc=true, show_only_auto_translation=true

[rewrite_local]
# 1. 基础广告拦截
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads url reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) url reject-200

# 2. 视频流与画质响应处理
^https?:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback) url script-response-header https://raw.githubusercontent.com/Ender-Wang/YouTubeAds-PiP-BackgroundPlay/main/youtube.response.preview.js

# 3. 主响应增强（去广告 / 屏蔽 Shorts / 开启后台播放与画中画）
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence) url script-response-body https://raw.githubusercontent.com/Ender-Wang/YouTubeAds-PiP-BackgroundPlay/main/youtube.response.preview.js

# 4. 双语与自动翻译字幕（来自 DualSubs 核心，与 kelee.one 字幕逻辑一致）
^https:\/\/(www|m)\.youtube\.com\/api\/timedtext\? url script-response-body https://raw.githubusercontent.com/DualSubs/YouTube/main/dist/DualSubs.YouTube.min.js
[mitm]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, s.youtube.com