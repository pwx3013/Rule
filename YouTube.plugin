#!name=YouTube 增强
#!desc=去除油管广告 / 支持后台播放 / 画中画 / 自动最高画质
#!author=gholts
#!homepage=https://github.com/gholts/surge/tree/main/modules
#!icon=https://iili.io/KQ67Yxa.png
#!tag=YouTube,去广告,增强
#!date=2026-10-21

[Argument]
blockUpload=switch,true,tag=隐藏「上传」入口,desc=隐藏导航栏中的「上传」入口
blockShorts=switch,true,tag=隐藏「Shorts」入口,desc=隐藏导航栏中的「Shorts」入口
autoHd=switch,true,tag=自动最高画质,desc=优先使用最高可用画质，并阻止自动降低画质
blockGames=switch,true,tag=隐藏小游戏推荐,desc=隐藏 YouTube Playables（小游戏）推荐
blockVerticalLive=switch,true,tag=隐藏竖屏直播推荐,desc=隐藏各界面中的竖屏直播推荐
jumpAhead=switch,true,tag=启用 Jump Ahead,desc=启用原生「Jump Ahead」跳转按钮，并去除其推广提示
blockStore=switch,true,tag=隐藏商店和购物板块,desc=隐藏视频下方和频道主页中的创作者商店、购物板块
nativeDownload=switch,true,tag=原生下载（实验性）,desc=实验性原生下载；未设置画质时使用 720p，服务器限制可能仍生效
subtitle_type=select,"Translate","Official",tag=[字幕] 启用类型,desc=Translate=自动翻译 / Official=官方字幕
auto_cc=switch,true,tag=[字幕] 自动显示,desc=是否总是自动开启字幕
show_only_auto_translation=switch,false,tag=[翻译器] 只显示译文,desc=true=仅译文，false=双语

[Rewrite]
# 广告拦截
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads reject

# timedtext 重写
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$2&$4&subtype=Translate$5 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ https://$1$2&subtype=Translate$4 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$3&subtype=Translate$4 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)tlang=([^&#]+)(#.*)?$ https://$1subtype=Translate$3 302

[Script]
# 空响应拦截 ad_break（LamJIson，原写法，纯文本不需要二进制）
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/youtube-ad-break.js, requires-body=false, timeout=10, tag=YT-ad_break

# IBL3ND 请求脚本（新写法，binary_body_mode=true）
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(\?(.*))?$/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js") with tag="YT-ad-break", requires_body=true, binary_body_mode=true

# 原生下载
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(\?(.*))?$/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js", {${nativeDownload}}) with tag="YT-download", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?(.*))?$/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js", {${nativeDownload}}) with tag="YT-download-player", requires_body=true, binary_body_mode=true

# 主响应增强
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?(.*))?$/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js", {${blockUpload}, ${blockShorts}, ${blockGames}, ${blockVerticalLive}, ${jumpAhead}, ${autoHd}, ${blockStore}}) with tag="YT-response", requires_body=true, binary_body_mode=true

# initplayback
response if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(\?(.*))?$/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js", {${blockGames}, ${blockVerticalLive}, ${jumpAhead}, ${autoHd}, ${blockStore}}) with tag="YT-ump", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(\?(.*))?$/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js") with tag="YT-init", requires_body=true, binary_body_mode=true

# videoplayback 自动高清
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js", {${autoHd}}) with tag="YT-auto-hd", requires_body=true, binary_body_mode=true

# log_event
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js") with tag="YT-log-event", requires_body=true, binary_body_mode=true

# 双语字幕（LamJIson，原写法，纯文本不需要二进制）
http-response ^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext(?:\?|$)) script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/youtube-dual-subs.js, requires-body=true, max-size=-1, timeout=30, tag=YT-DualSubs, argument=subtitle_type={subtitle_type}&show_only_auto_translation={show_only_auto_translation}

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, tv.youtube.com, s.youtube.com, music.youtube.com
